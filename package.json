{
  "name": "gridrunner",
  "version": "1.0.0",
  "description": "GRIDRUNNER — a cyberpunk habit tracker. Hack the city through self-improvement.",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "7.18.8",
    "@react-navigation/native": "7.3.8",
    "@react-navigation/native-stack": "7.17.10",
    "expo": "57.0.4",
    "expo-asset": "57.0.3",
    "expo-audio": "57.0.0",
    "expo-font": "57.0.0",
    "expo-haptics": "57.0.0",
    "expo-notifications": "57.0.3",
    "expo-status-bar": "57.0.0",
    "firebase": "12.16.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.0",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "babel-preset-expo": "57.0.2",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "jest": "29.7.0",
    "ts-jest": "29.4.11",
    "typescript": "5.9.3"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/__tests__"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "json"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "jsx": "react-jsx",
            "esModuleInterop": true,
            "allowSyntheticDefaultImports": true,
            "strict": true,
            "target": "es2020",
            "module": "commonjs",
            "moduleResolution": "node",
            "skipLibCheck": true
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^firebase/app$": "<rootDir>/__mocks__/firebase/app.ts",
      "^firebase/auth$": "<rootDir>/__mocks__/firebase/auth.ts",
      "^firebase/firestore$": "<rootDir>/__mocks__/firebase/firestore.ts",
      "^@react-native-async-storage/async-storage$": "<rootDir>/__mocks__/async-storage.ts"
    }
  }
}
