{
  "name": "gridrunner",
  "version": "1.0.0",
  "description": "GRIDRUNNER — a cyberpunk habit tracker. Hack the city through self-improvement.",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "14.1.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-navigation/bottom-tabs": "7.3.10",
    "@react-navigation/native": "7.1.6",
    "@react-navigation/native-stack": "7.3.10",
    "expo": "53.0.9",
    "expo-asset": "11.1.5",
    "expo-av": "15.1.4",
    "expo-haptics": "14.1.4",
    "expo-notifications": "0.31.2",
    "expo-status-bar": "2.2.3",
    "firebase": "11.6.0",
    "react": "19.0.0",
    "react-native": "0.79.2",
    "react-native-reanimated": "3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "4.10.0",
    "react-native-svg": "15.11.2",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@babel/core": "7.26.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "jest": "29.7.0",
    "ts-jest": "29.3.2",
    "typescript": "5.8.3"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/__tests__"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "json"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "jsx": "react-jsx",
            "esModuleInterop": true,
            "allowSyntheticDefaultImports": true,
            "strict": true,
            "target": "es2020",
            "module": "commonjs",
            "moduleResolution": "node",
            "skipLibCheck": true
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^firebase/app$": "<rootDir>/__mocks__/firebase/app.ts",
      "^firebase/auth$": "<rootDir>/__mocks__/firebase/auth.ts",
      "^firebase/firestore$": "<rootDir>/__mocks__/firebase/firestore.ts",
      "^@react-native-async-storage/async-storage$": "<rootDir>/__mocks__/async-storage.ts"
    }
  }
}
